/* Neutral control surfaces with distinct, readable conversation panels. */
QWidget { color: #e4e7eb; background-color: #262a30; }
QMainWindow, QDialog { background-color: #262a30; }
QTextEdit, QPlainTextEdit, QLineEdit, QAbstractSpinBox, QComboBox, QAbstractItemView {
  background-color: #343a42; color: #edf0f4;
  border: 1px solid #626c79; border-radius: 4px; padding: 3px;
  selection-background-color: #586b7e; selection-color: #ffffff;
}
QTextEdit#decodedTextBrowser, QTextEdit#decodedTextBrowser2 {
  background-color: #20252b; border: 1px solid #586370; padding: 7px;
}
QLabel#lh_decodes_title_label, QLabel#rh_decodes_title_label {
  background-color: #3c4652; color: #edf0f4; padding: 5px; font-weight: bold;
  border-radius: 4px;
}
QPushButton { background-color: #414a56; border: 1px solid #657180; border-radius: 4px; padding: 4px 7px; }
QPushButton:hover { background-color: #526070; }
QPushButton:pressed { background-color: #293441; }
QPushButton:disabled, QAbstractSpinBox:disabled { color: #919aa5; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border: 2px solid #586b7e; }
QGroupBox { border: 1px solid #626c79; border-radius: 5px; margin-top: 12px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; }
QMenuBar, QMenu { background-color: #262a30; color: #edf0f4; }
QMenu::item:selected { background-color: #586b7e; color: white; }
QTabWidget::pane { border: 1px solid #4d5865; }
QTabBar::tab { background-color: #303943; padding: 6px 10px; border: 1px solid #4d5865; }
QTabBar::tab:selected { background-color: #414a56; }
QToolTip { background-color: #343a42; color: #edf0f4; border: 1px solid #626c79; }
QSplitter::handle { background-color: #4d5865; }

QFrame[jttyPanel="true"] { background-color: #30363e; border: 1px solid #56616e; border-radius: 7px; }
QFrame#jttyFrequencyStrip, QFrame#jttyWaterfallPanel { background-color: #363f49; }
QFrame#jttyConversationPanel { background-color: #29313a; }
QLabel[jttyHeading="true"] { font-weight: bold; }
QLabel#jttyCatStatus { font-weight: bold; padding: 5px; }
QLabel#jttyDeviceStatus { padding: 3px; color: #bdc8d4; }
QLabel#jttyConversationScope, QLabel#jttyDraftCount { color: #b0becb; }
QLineEdit#Tx_Message { background-color: #20252b; padding: 6px; }
QProgressBar { background-color: #262a30; border: 1px solid #657180; border-radius: 3px; }
QProgressBar::chunk { background-color: #586f82; }

QWidget#jttyWorkbenchRoot QWidget, QDialog#jttyFloatingConversation QWidget { }
QWidget#jttyWorkbenchRoot QLabel, QDialog#jttyFloatingConversation QLabel { background: transparent; }
QLabel[jttyFieldLabel="true"] { }
QLabel#lh_decodes_title_label, QLabel#rh_decodes_title_label { padding: 4px; }

QCheckBox::indicator { background: #20252b; border: 1px solid #8996a5; border-radius: 3px; }
QCheckBox::indicator:checked { background: #689ec7; }
